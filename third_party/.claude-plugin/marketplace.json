    { "name": "andrej-karpathy-skills",  "source": "./plugins/andrej-karpathy-skills",  "description": "multica-ai/andrej-karpathy-skills (MIT)" },
    { "name": "claude-security",         "source": "./plugins/claude-security",         "description": "anthropics/claude-plugins-official (Apache-2.0)" },
    { "name": "phoenix-security-review", "source": "./plugins/phoenix-security-review", "description": "Security-Phoenix-demo/security-skills-claude-code (MIT)" }
  ]
